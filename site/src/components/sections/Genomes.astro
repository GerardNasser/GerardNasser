---
import Section from '../Section.astro';
import genomes from '../../data/genomes.json';

const items = [...genomes.items].sort((a, b) => b.year - a.year);
---

<Section id="genomes" title="Genome submissions">
  <p class="lede" data-reveal>{genomes.lede}</p>

  <table class="gen" data-reveal>
    <thead>
      <tr>
        <th scope="col">Phage</th>
        <th scope="col">GenBank accession</th>
        <th scope="col" class="gen__num">Year</th>
      </tr>
    </thead>
    <tbody>
      {
        items.map((g) => (
          <tr>
            <th scope="row">{g.name}</th>
            <td>
              <a href={g.url} target="_blank" rel="noopener">{g.accession}</a>
            </td>
            <td class="gen__num">{g.year}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</Section>

<style>
  .gen { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .gen th,
  .gen td { text-align: left; padding: var(--sp-2) var(--sp-2) var(--sp-2) 0; border-top: 1px solid var(--border); vertical-align: baseline; }
  .gen tbody tr:last-child > * { border-bottom: 1px solid var(--border); }
  .gen thead th {
    border-top: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-0);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .gen tbody th { font-family: var(--font-serif); font-weight: 500; font-size: var(--fs-3); color: var(--fg); }
  .gen td { font-size: var(--fs-1); color: var(--fg-soft); }
  .gen__num { text-align: right !important; padding-right: 0 !important; }
  .gen a { text-decoration: underline; text-decoration-color: var(--border-bright); text-underline-offset: 3px; }
  .gen a:hover { text-decoration-color: currentColor; }
  @media (max-width: 480px) {
    .gen tbody th { font-size: 1.0625rem; }
  }
</style>
