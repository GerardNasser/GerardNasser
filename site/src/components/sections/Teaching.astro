---
import Section from '../Section.astro';
import teaching from '../../data/teaching.json';

const experience = teaching.experience as Array<{
  role: string;
  org: string;
  period: string;
  detail: string;
}>;
const items = teaching.items;
---

<Section id="teaching" title="Teaching">
  <p class="lede" data-reveal>{teaching.lede}</p>

  <ul class="rows">
    {
      experience.map((x) => (
        <li class="row" data-reveal>
          <span class="row__meta">{x.period}</span>
          <div>
            <h3 class="row__title">{x.role}</h3>
            <p class="row__sub">{x.org}</p>
            <p class="row__text">{x.detail}</p>
          </div>
        </li>
      ))
    }
  </ul>

  <h3 class="sub" data-reveal>Materials</h3>
  <ul class="rows">
    {
      items.map((it) => (
        <li data-reveal>
          <a class="row" href={it.href} target="_blank" rel="noopener">
            <span class="row__meta">{it.tag}</span>
            <div>
              <p class="row__title">
                {it.title}
                <span class="row__arrow" aria-hidden="true">&nearr;</span>
              </p>
              <p class="row__text">{it.desc}</p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</Section>
