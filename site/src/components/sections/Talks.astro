---
import Section from '../Section.astro';
import talks from '../../data/talks.json';

type Talk = { title: string; event: string; year: number; type: 'talk' | 'poster'; url?: string };

// One row per piece of work per year; a talk and a poster of the same work
// are listed as two venues on that row.
const groups = new Map<string, { title: string; year: number; url?: string; venues: Talk[] }>();
for (const t of talks.items as Talk[]) {
  const key = `${t.year}|${t.title}`;
  const g = groups.get(key) ?? { title: t.title, year: t.year, url: t.url, venues: [] };
  g.venues.push(t);
  groups.set(key, g);
}
const sorted = [...groups.values()].sort((a, b) => b.year - a.year);
---

<Section id="talks" title="Talks and posters">
  <ul class="rows">
    {
      sorted.map((g) => (
        <li class="row" data-reveal>
          <span class="row__meta">{g.year}</span>
          <div>
            <h3 class="row__title">
              {g.url ? (
                <a href={g.url} target="_blank" rel="noopener">{g.title}</a>
              ) : (
                g.title
              )}
            </h3>
            <ul class="venues">
              {g.venues.map((v) => (
                <li>
                  <span class="chip">{v.type}</span>
                  <span>{v.event}</span>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
