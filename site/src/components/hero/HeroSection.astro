---
import { site } from '../../data/site';
---

<section class="hero" id="top" data-hero>
  <div class="container">
    <p class="hero__eyebrow">{site.role} · UNC Charlotte</p>
    <h1 class="hero__name">{site.name}</h1>
    <p class="hero__summary">{site.summary}</p>
    <p class="hero__links">
      <a class="hero__cta" href="#research">Research</a>
      <a class="hero__link" href="#software">Software</a>
      <a class="hero__link" href={`mailto:${site.email}`}>Email</a>
    </p>
  </div>

  <!-- the helix runs in its own band below the text, off both edges of the page -->
  <figure class="hero__fig">
    <div class="hero__stage">
      <!-- live WebGL target -->
      <canvas class="hero__canvas" aria-hidden="true"></canvas>

      <!-- static fallback: shown until/unless the canvas goes live -->
      <svg class="hero__poster" viewBox="0 0 600 200" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
        <g fill="none" stroke-width="2.5">
          <path d="M20,100 C110,30 190,30 300,100 S490,170 580,100" stroke="#4f9fd6" opacity="0.8" />
          <path d="M20,100 C110,170 190,170 300,100 S490,30 580,100" stroke="#4f9fd6" opacity="0.8" />
        </g>
        <g>
          <circle cx="130" cy="58" r="6" fill="#3df06b" /><circle cx="130" cy="142" r="6" fill="#ff4d6d" />
          <circle cx="300" cy="100" r="6" fill="#ffc83d" /><circle cx="470" cy="58" r="6" fill="#28e0f5" />
          <circle cx="470" cy="142" r="6" fill="#3df06b" />
        </g>
      </svg>
    </div>
    <figcaption class="container hero__cap">
      <span><b>Fig. 1</b> DNA double helix, coloured by base</span>
      <ul class="hero__legend">
        <li><i style="background:var(--nt-a)"></i>A</li>
        <li><i style="background:var(--nt-t)"></i>T</li>
        <li><i style="background:var(--nt-g)"></i>G</li>
        <li><i style="background:var(--nt-c)"></i>C</li>
      </ul>
    </figcaption>
  </figure>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(var(--sp-5), 9vw, var(--sp-7));
    overflow: hidden;
  }
  .hero__eyebrow {
    font-size: var(--fs-0);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 var(--sp-3);
  }
  .hero__name {
    font-size: clamp(2.75rem, 8.5vw, 6rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin: 0;
  }
  .hero__summary {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.3vw, 1.75rem);
    line-height: 1.4;
    color: var(--fg-soft);
    max-width: 36ch;
    margin: var(--sp-3) 0 0;
    text-wrap: pretty;
  }
  .hero__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-1) var(--sp-3);
    margin: var(--sp-4) 0 0;
    font-size: var(--fs-1);
  }
  .hero__cta,
  .hero__link { display: inline-flex; align-items: center; min-height: 44px; }
  .hero__cta {
    padding-inline: var(--sp-3);
    border-radius: 8px;
    background: var(--fg);
    color: var(--bg);
    font-weight: 700;
    transition: background 0.2s var(--ease-out);
  }
  .hero__cta:hover { background: var(--accent); color: var(--bg); }
  .hero__link {
    color: var(--fg-soft);
    text-decoration: underline;
    text-decoration-color: var(--border-bright);
    text-underline-offset: 5px;
  }
  .hero__link:hover { color: var(--fg); text-decoration-color: currentColor; }

  .hero__fig { margin: var(--sp-3) 0 0; }
  .hero__stage {
    position: relative;
    height: clamp(11rem, 30vw, 22rem);
    /* fade the strand out toward both page edges */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .hero__poster {
    position: absolute;
    inset: 0;
    margin: auto;
    width: min(96%, 1100px);
    height: 70%;
    opacity: 0.9;
  }
  /* once the canvas is live, drop the static poster */
  .hero[data-live] .hero__poster { display: none; }

  .hero__cap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-1) var(--sp-3);
    padding-block: var(--sp-2) var(--sp-4);
    font-size: var(--fs-0);
    color: var(--fg-faint);
  }
  .hero__cap b { color: var(--fg-soft); font-weight: 500; margin-right: var(--sp-1); }
  .hero__legend { list-style: none; display: flex; gap: var(--sp-2); padding: 0; margin: 0; }
  .hero__legend li { display: inline-flex; align-items: center; gap: 5px; }
  .hero__legend i { width: 8px; height: 8px; border-radius: 50%; }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = hero?.querySelector<HTMLCanvasElement>('.hero__canvas');
  const mq = window.matchMedia('(prefers-reduced-motion: reduce)');

  const hasWebGL = (() => {
    try {
      const c = document.createElement('canvas');
      return !!(window.WebGLRenderingContext && (c.getContext('webgl') || c.getContext('experimental-webgl')));
    } catch {
      return false;
    }
  })();

  // reduced-motion or no WebGL: the static poster stays
  if (hero && canvas && !mq.matches && hasWebGL) {
    let controller: { destroy: () => void } | null = null;

    const start = () =>
      import('./helix')
        .then((m) => {
          controller = m.initHelix(canvas);
          hero.dataset.live = '';
        })
        .catch(() => {
          /* import failed: the poster stays */
        });

    if ('requestIdleCallback' in window) {
      (window as Window & typeof globalThis).requestIdleCallback(start, { timeout: 1500 });
    } else {
      setTimeout(start, 200);
    }

    // honor a live OS reduced-motion toggle
    mq.addEventListener('change', (e) => {
      if (e.matches && controller) {
        controller.destroy();
        controller = null;
        hero.removeAttribute('data-live');
      }
    });
  }
</script>
